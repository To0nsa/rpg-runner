{
  "displayName": "RPG Runner - replay validator memory pressure",
  "documentation": {
    "content": "Replay-validator p99 memory utilization stayed above 90%. Inspect replay limit classifications and instance logs; do not raise limits until representative and adversarial measurements justify it.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "P99 memory utilization above 90% for 5 minutes",
      "conditionThreshold": {
        "filter": "metric.type=\"run.googleapis.com/container/memory/utilizations\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"replay-validator\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_PERCENTILE_99",
            "crossSeriesReducer": "REDUCE_MAX"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0.9,
        "duration": "300s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "combiner": "OR",
  "enabled": true,
  "alertStrategy": {
    "autoClose": "3600s"
  },
  "userLabels": {
    "component": "replay-validator",
    "severity": "warning"
  }
}
