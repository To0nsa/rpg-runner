{
  "displayName": "RPG Runner - Reward settlement",
  "labels": {
    "component": "reward-settlement",
    "managed_by": "repository"
  },
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 12,
        "height": 2,
        "widget": {
          "text": {
            "format": "MARKDOWN",
            "content": "# Reward settlement\n\nThe canonical wallet is the authority. Validation, immediate delivery, Eventarc, and repair are independent stages; projection never affects payout. Use the log panels for run-session correlation and the alerts for escalation."
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 2,
        "width": 12,
        "height": 6,
        "widget": {
          "title": "Durable finalize to settlement handoff",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "thresholds": [
              {
                "label": "Alert threshold",
                "value": 15000
              },
              {
                "label": "p99 rollout target",
                "value": 30000
              }
            ],
            "yAxis": {
              "label": "milliseconds",
              "scale": "LINEAR"
            },
            "dataSets": [
              {
                "legendTemplate": "p50",
                "plotType": "LINE",
                "minAlignmentPeriod": "300s",
                "timeSeriesQuery": {
                  "unitOverride": "ms",
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/reward_settlement_finalize_to_handoff_latency_ms\" resource.type=\"cloud_run_revision\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_50"
                    }
                  }
                }
              },
              {
                "legendTemplate": "p95",
                "plotType": "LINE",
                "minAlignmentPeriod": "300s",
                "timeSeriesQuery": {
                  "unitOverride": "ms",
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/reward_settlement_finalize_to_handoff_latency_ms\" resource.type=\"cloud_run_revision\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_95"
                    }
                  }
                }
              },
              {
                "legendTemplate": "p99",
                "plotType": "LINE",
                "minAlignmentPeriod": "300s",
                "timeSeriesQuery": {
                  "unitOverride": "ms",
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/reward_settlement_finalize_to_handoff_latency_ms\" resource.type=\"cloud_run_revision\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_99"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 8,
        "width": 6,
        "height": 5,
        "widget": {
          "title": "Immediate settlement fallback ratio",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "thresholds": [
              {
                "label": "Alert threshold (5%)",
                "value": 0.05
              }
            ],
            "yAxis": {
              "label": "fraction (0.05 = 5%)",
              "scale": "LINEAR"
            },
            "dataSets": [
              {
                "legendTemplate": "fallback / attempts",
                "plotType": "LINE",
                "minAlignmentPeriod": "300s",
                "timeSeriesQuery": {
                  "timeSeriesFilterRatio": {
                    "numerator": {
                      "filter": "metric.type=\"logging.googleapis.com/user/reward_settlement_immediate_dispatch_fallbacks\" resource.type=\"cloud_run_revision\"",
                      "aggregation": {
                        "alignmentPeriod": "300s",
                        "perSeriesAligner": "ALIGN_SUM",
                        "crossSeriesReducer": "REDUCE_SUM"
                      }
                    },
                    "denominator": {
                      "filter": "metric.type=\"logging.googleapis.com/user/reward_settlement_immediate_dispatch_attempts\" resource.type=\"cloud_run_revision\"",
                      "aggregation": {
                        "alignmentPeriod": "300s",
                        "perSeriesAligner": "ALIGN_SUM",
                        "crossSeriesReducer": "REDUCE_SUM"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 8,
        "width": 6,
        "height": 5,
        "widget": {
          "title": "Immediate settlement delivery activity",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "yAxis": {
              "label": "events per five minutes",
              "scale": "LINEAR"
            },
            "dataSets": [
              {
                "legendTemplate": "attempts",
                "plotType": "LINE",
                "minAlignmentPeriod": "300s",
                "timeSeriesQuery": {
                  "unitOverride": "1",
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/reward_settlement_immediate_dispatch_attempts\" resource.type=\"cloud_run_revision\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_SUM",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                }
              },
              {
                "legendTemplate": "fallbacks",
                "plotType": "LINE",
                "minAlignmentPeriod": "300s",
                "timeSeriesQuery": {
                  "unitOverride": "1",
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/reward_settlement_immediate_dispatch_fallbacks\" resource.type=\"cloud_run_revision\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_SUM",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 13,
        "width": 6,
        "height": 5,
        "widget": {
          "title": "Validator task server errors",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "yAxis": {
              "label": "5xx requests per five minutes",
              "scale": "LINEAR"
            },
            "dataSets": [
              {
                "legendTemplate": "Cloud Tasks validation 5xx",
                "plotType": "LINE",
                "minAlignmentPeriod": "300s",
                "timeSeriesQuery": {
                  "unitOverride": "1",
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"replay-validator\" metric.label.\"response_code_class\"=\"5xx\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_SUM",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 13,
        "width": 6,
        "height": 5,
        "widget": {
          "title": "Settlement decisions and pending age",
          "logsPanel": {
            "resourceNames": [
              "projects/rpg-runner-d7add"
            ],
            "filter": "jsonPayload.message=\"run_settlement\" AND (jsonPayload.event=\"settlement_transaction\" OR jsonPayload.event=\"settlement_eventarc_delivery\")"
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 18,
        "width": 6,
        "height": 5,
        "widget": {
          "title": "Settlement repair and invariant signals",
          "logsPanel": {
            "resourceNames": [
              "projects/rpg-runner-d7add"
            ],
            "filter": "jsonPayload.message=\"run_settlement\" AND (jsonPayload.event=\"settlement_repair_scan\" OR jsonPayload.event=\"stale_settlement_repair\" OR jsonPayload.outcome=\"invariant_violation\")"
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 18,
        "width": 6,
        "height": 5,
        "widget": {
          "title": "Validator fallback and projection retries",
          "logsPanel": {
            "resourceNames": [
              "projects/rpg-runner-d7add"
            ],
            "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"replay-validator\" AND jsonPayload.event=\"replay_validator.dispatch\" AND (jsonPayload.phase=\"settlement_dispatch_fallback\" OR jsonPayload.phase=\"projection_retry\" OR jsonPayload.status=\"retryScheduled\")"
          }
        }
      }
    ]
  }
}
