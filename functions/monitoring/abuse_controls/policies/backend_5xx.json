{
  "displayName": "RPG Runner - Functions backend HTTP 5xx",
  "documentation": {
    "content": "A Cloud Functions or other non-validator Cloud Run backend returned a 5xx response. Inspect the service revision, structured route telemetry, Firestore/Storage/Tasks dependencies, and transaction-contention policy. Replay-validator 5xx has its own policy.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "Any non-validator backend 5xx in 5 minutes",
      "conditionThreshold": {
        "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name!=\"replay-validator\" AND metric.label.response_code_class=\"5xx\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_SUM",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "0s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "combiner": "OR",
  "enabled": true,
  "alertStrategy": {
    "autoClose": "3600s"
  },
  "userLabels": {
    "component": "functions-backend",
    "severity": "warning"
  }
}
