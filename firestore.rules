rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /run_completion_receipts/{uid}/runs/{runSessionId} {
      // The owner can watch an as-yet absent receipt. No collection listing or
      // client write is needed. Deletion immediately fences existing sessions.
      allow get: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.identities['playgames.google.com'] is list
        && request.auth.token.firebase.identities['playgames.google.com'].size() > 0
        && !exists(/databases/$(database)/documents/account_deletion_requests/$(uid));
      allow list, write: if false;
    }
    match /inbox_configuration/{configurationId} {
      allow read, write: if false;
    }
    match /system_messages/{messageId} {
      allow read, write: if false;
    }
    match /inbox_rewards/{messageId} {
      allow read, write: if false;
    }
    match /inbox_receipts/{messageId} {
      allow read, write: if false;
    }
    match /inbox_summaries/{uid} {
      allow read, write: if false;
    }
    match /ownership_profiles/{docId} {
      allow read, write: if false;

      match /idempotency/{commandId} {
        allow read, write: if false;
      }
    }

    match /player_profiles/{uid} {
      allow read, write: if false;
    }

    match /display_name_index/{normalizedName} {
      allow read, write: if false;
    }

    match /account_deletion_requests/{uid} {
      allow read, write: if false;
    }

    match /abuse_quota/{uid} {
      allow read, write: if false;
    }
  }
}
