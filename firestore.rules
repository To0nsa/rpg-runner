rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /system_messages/{messageId} {
      allow read, write: if false;
    }
    match /inbox_rewards/{messageId} {
      allow read, write: if false;
    }
    match /inbox_summaries/{uid} {
      allow read, write: if false;
    }
    match /ownership_profiles/{docId} {
      allow read, write: if false;

      match /idempotency/{commandId} {
        allow read, write: if false;
      }
    }

    match /player_profiles/{uid} {
      allow read, write: if false;
    }

    match /display_name_index/{normalizedName} {
      allow read, write: if false;
    }

    match /account_deletion_requests/{uid} {
      allow read, write: if false;
    }

    match /abuse_quota/{uid} {
      allow read, write: if false;
    }
  }
}
